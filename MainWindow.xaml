<Window x:Class="MiniPlayer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" SizeToContent="Width" Height="40" Title="MiniPlayer" Icon="app.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" RenderOptions.BitmapScalingMode="HighQuality">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#33FFFFFF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="Root" Background="#01000000" CornerRadius="6" Padding="4,0" ClipToBounds="True">
    <Grid x:Name="Layout">
      <Grid.LayoutTransform><ScaleTransform x:Name="SizeScale" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="ArtBox" Grid.Column="1" Margin="6,0,0,0" Width="30" Height="30" CornerRadius="4" ClipToBounds="True" Background="#22FFFFFF">
        <Grid>
          <TextBlock x:Name="NoArt" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Image x:Name="Art" Stretch="UniformToFill"/>
          <!-- volume ao rolar o mouse (aparece por 1 s sobre a capa) -->
          <Border x:Name="VolBadge" Background="#B0000000" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="VolText" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Grid>
      </Border>
      <!-- campo de texto com largura fixa; o título rola (em loop) ao passar o mouse quando não cabe -->
      <StackPanel x:Name="InfoPanel" Grid.Column="2" Margin="8,0" Width="150" VerticalAlignment="Center" Background="#01000000">
        <Canvas x:Name="TitleHost" Height="16" ClipToBounds="True">
          <TextBlock x:Name="TitleText" Width="150" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        </Canvas>
        <TextBlock x:Name="ArtistText" TextAlignment="Left" Foreground="#BBFFFFFF" FontSize="11" TextTrimming="CharacterEllipsis"/>
        <!-- barra de progresso (clique para avançar/voltar) -->
        <Grid x:Name="Progress" Height="7" Margin="0,2,0,0" Background="#01000000" Cursor="Hand" Visibility="Collapsed">
          <Border x:Name="ProgTrack" Height="2" VerticalAlignment="Center" Background="White" Opacity="0.25" CornerRadius="1"/>
          <Border x:Name="ProgFill" Height="2" VerticalAlignment="Center" HorizontalAlignment="Left" Width="0" Background="White" CornerRadius="1"/>
        </Grid>
      </StackPanel>
      <UniformGrid x:Name="Spectrum" Grid.Column="0" Rows="1" Opacity="0.28" IsHitTestVisible="False"/>
      <StackPanel x:Name="Controls" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="PrevBtn" Content="&#xE892;" Click="Prev_Click"/>
        <Button x:Name="PlayBtn" Content="&#xE768;" Click="Play_Click"/>
        <Button x:Name="NextBtn" Content="&#xE893;" Click="Next_Click"/>
        <Button x:Name="SwapBtn" Click="Swap_Click" Visibility="Collapsed">
          <!-- duas setas opostas (⇄): alternar entre as mídias abertas -->
          <Path x:Name="SwapIcon" Data="M2,5 H13 M10,2 L13,5 L10,8 M14,12 H3 M6,9 L3,12 L6,15" Stroke="White" StrokeThickness="1.5"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="12" Stretch="Uniform" SnapsToDevicePixels="True"/>
        </Button>
      </StackPanel>
      <StackPanel x:Name="BatteryPanel" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0"/>
    </Grid>
  </Border>
</Window>
